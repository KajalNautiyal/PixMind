PORT=5000
NODE_ENV=development

# MongoDB Atlas — Get from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pixmind?retryWrites=true&w=majority

# JWT — Change to a random secure string
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Gmail OTP — Use App Password (Google Account > Security > App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=PixMind AI <your_email@gmail.com>

# OTP Settings
OTP_EXPIRY_MINUTES=10
